# Genius Web (copy to .env.local). Both values are PUBLIC by design: row level security protects the data.
# NEVER put a Supabase service-role key or any AI provider key in this file.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
# Development only: run without accounts (conversations stay in the browser). Ignored in production builds.
# VITE_GENIUS_LOCAL=1
