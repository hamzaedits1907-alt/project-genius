{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Permissions for the local Genius UI in the main window. Not granted to any remote URL.",
  "windows": [
    "main"
  ],
  "local": true,
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://127.0.0.1:*"
        }
      ]
    },
    "allow-get-settings",
    "allow-save-settings",
    "allow-key-status",
    "allow-save-api-key",
    "allow-remove-api-key",
    "allow-test-connection",
    "allow-list-models",
    "allow-probe-model",
    "allow-select-model",
    "allow-detect-tools",
    "allow-app-info",
    "allow-list-projects",
    "allow-get-project",
    "allow-create-project",
    "allow-import-project",
    "allow-open-project",
    "allow-update-project-meta",
    "allow-delete-project",
    "allow-update-spec",
    "allow-list-messages",
    "allow-list-files",
    "allow-read-file",
    "allow-save-file",
    "allow-delete-file",
    "allow-search-files",
    "allow-start-plan",
    "allow-start-generate",
    "allow-preview-context",
    "allow-start-change",
    "allow-start-diagnose",
    "allow-cancel-task",
    "allow-active-tasks",
    "allow-repair-attempts",
    "allow-reset-repair-attempts",
    "allow-pending-approvals",
    "allow-respond-approval",
    "allow-list-changesets",
    "allow-get-changeset",
    "allow-apply-changeset",
    "allow-reject-changeset",
    "allow-propose-revert",
    "allow-propose-restore-to",
    "allow-start-operation",
    "allow-list-runs",
    "allow-active-runs",
    "allow-stop-run",
    "allow-needs-install",
    "allow-start-preview",
    "allow-stop-preview",
    "allow-preview-status",
    "allow-list-activity",
    "allow-export-project",
    "allow-readiness",
    "allow-git-view",
    "allow-git-init",
    "allow-git-diff",
    "allow-git-stage",
    "allow-staged-findings",
    "allow-git-commit",
    "allow-suggest-commit-message",
    "allow-git-log",
    "allow-git-commit-detail",
    "allow-git-branches",
    "allow-git-branch",
    "allow-git-set-identity",
    "allow-git-set-remote",
    "allow-git-fetch",
    "allow-git-pull",
    "allow-git-push",
    "allow-git-merge-abort",
    "allow-git-resolve",
    "allow-propose-conflict-resolution",
    "allow-ensure-gitignore",
    "allow-github-status",
    "allow-github-login-web",
    "allow-github-login-token",
    "allow-github-logout",
    "allow-github-repos",
    "allow-github-orgs",
    "allow-github-clone",
    "allow-publish-plan",
    "allow-publish",
    "allow-record-ui-error",
    "allow-recent-ui-errors"
  ]
}
